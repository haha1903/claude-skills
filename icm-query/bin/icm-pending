#!/usr/bin/env node
/**
 * Query the IcM Kusto warehouse for pending-action incidents (BET tenant 25998).
 * Thin CLI over iris icm.pendingActions.
 *
 *   icm-pending [--owner me|<alias>|unassigned|all]
 *
 * --owner filters by OwningContactAlias: "me" (current user), "unassigned"
 * (team-owned, no individual), "all" or omitted (no filter). Default:
 * $ICM_QUERY_OWNER or no filter.
 */
import os from "node:os";
import { icm } from "../../_iris-shared/index.mjs";

const argv = process.argv.slice(2);
const oi = argv.indexOf("--owner");
const owner = oi >= 0 ? argv[oi + 1] : process.env.ICM_QUERY_OWNER;

const rows = await icm.pendingActions(owner);
const lower = owner ? String(owner).toLowerCase() : "";
const alias = !owner || lower === "all" ? null
  : lower === "me" ? os.userInfo().username
  : lower === "unassigned" ? "" : owner;

console.log(JSON.stringify({
  cluster: icm.WAREHOUSE_CLUSTER,
  database: icm.WAREHOUSE_DB,
  owningTenantId: icm.OWNING_TENANT_ID,
  ownerFilter: alias,
  count: rows.length,
  incidents: rows,
}, null, 2));
