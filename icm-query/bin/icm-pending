#!/usr/bin/env node
/**
 * Query the IcM Kusto warehouse for the configured tenant's pending-action
 * incidents. Thin CLI over iris icm.pendingActions (warehouse cluster + owning
 * tenant come from ~/.iris/config.json).
 *
 *   icm-pending [--owner me|<alias>|unassigned|all]
 *
 * --owner filters by OwningContactAlias: "me" (current user), "unassigned"
 * (team-owned, no individual), "all" or omitted (no filter). Default:
 * $ICM_QUERY_OWNER or no filter.
 */
import { icm } from "../../_iris-shared/index.mjs";

const argv = process.argv.slice(2);
const oi = argv.indexOf("--owner");
const owner = oi >= 0 ? argv[oi + 1] : process.env.ICM_QUERY_OWNER;

const rows = await icm.pendingActions(owner);
// icm.resolveOwner, not a second copy of the same three lines. This file used to repeat
// them to echo `ownerFilter`, and the copy still called os.userInfo() after iris had
// stopped -- so `--owner me` kept dying with `uv_os_get_passwd returned ENOENT` in the
// container, one line further down than before. Duplicated logic is what made the fix
// look applied while the crash stayed.
const { alias } = icm.resolveOwner(owner);

console.log(JSON.stringify({
  database: icm.WAREHOUSE_DB,
  ownerFilter: alias,
  count: rows.length,
  incidents: rows,
}, null, 2));
