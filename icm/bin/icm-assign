#!/usr/bin/env node
/**
 * Assign an IcM incident to an individual AND acknowledge it as that person. WRITE OP.
 *
 * Goes through iris icm.assignMany rather than icm.assign, because the bare assign only
 * PATCHes OwningContactAlias and leaves the incident unacknowledged -- which keeps it
 * paging and still reading as untriaged. A pass using the bare form left 37 of 145
 * incidents in that state while reporting success.
 *
 * Acknowledging is what sets the owner anyway (AcknowledgeIncident writes
 * OwningContactAlias to whatever alias it is given), so one call covers both states.
 *
 *   icm-assign <ID> <alias>      # assign + acknowledge as that person
 *   icm-assign <ID> ""           # unassign (no ack: there is nobody to ack as)
 */
import { icm } from "../../_iris-shared/index.mjs";

const argv = process.argv.slice(2);
if (argv.length < 2) { console.error('usage: icm-assign ID ALIAS   (ALIAS="" to unassign)'); process.exit(2); }
const [incidentId, alias] = argv;

const res = await icm.assignMany({ [incidentId]: alias });
if (res.failed.length) {
  console.error(`FAILED ${incidentId}: ${res.failed[0]?.error ?? "unknown"}`);
  process.exit(1);
}
const got = await icm.getIncident(incidentId);
const owner = got?.OwningContactAlias ?? null;
console.log(`OK ${incidentId} -> ${JSON.stringify(owner)}${alias ? ` (acknowledged: ${icm.isAcked(got)})` : ""}`);
